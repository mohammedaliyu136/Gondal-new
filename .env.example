# Gondal ERP — environment template
# ARCH-1: Laravel + PostgreSQL or MySQL 8+, Redis for queues and cache.

APP_NAME="Gondal ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ARCH-9 / ARCH-10 — store UTC, present WAT; NGN / en-NG.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
GONDAL_DISPLAY_TIMEZONE=Africa/Lagos

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# NFR-9 — structured logging with request IDs, no secrets.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ARCH-1 — production target. Use pgsql or mysql; sqlite is for local smoke runs only.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gondal_erp
DB_USERNAME=gondal
DB_PASSWORD=

# NFR-7 — secure, http-only cookies.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ARCH-1 / NOTIF-5 — queues and cache on Redis; sends are never synchronous.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@gondalfulbe.ng"
MAIL_FROM_NAME="${APP_NAME}"

# NFR-12 — reproduce the prototype's figures for screen-by-screen review.
GONDAL_SEED_DEMO_DATA=false
